# Copy to .env; use a secret manager/private permissions. Never commit real values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://nightbrew:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/nightbrew
API_DOMAIN=api.nightbrew.dev
ACME_EMAIL=REPLACE_WITH_OWNER_EMAIL
NIGHTBREW_BILLING_MODE=mock
NIGHTBREW_BILLING_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
NIGHTBREW_LICENSE_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_KEY
# Shared provider credentials belong only to this trusted service.
NIGHTBREW_GATEWAY_KEY=
