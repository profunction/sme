# Copy to .env; use a secret manager/private permissions. Never commit real values.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_PASSWORD
DATABASE_URL=postgresql://nightbrew:REPLACE_WITH_URL_ENCODED_PASSWORD@database:5432/nightbrew
API_DOMAIN=api.nightbrew.dev
ACME_EMAIL=REPLACE_WITH_OWNER_EMAIL
NIGHTBREW_BILLING_MODE=mock
NIGHTBREW_BILLING_ADMIN_KEY=REPLACE_WITH_RANDOM_ADMIN_KEY
NIGHTBREW_LICENSE_PRIVATE_KEY=REPLACE_WITH_ED25519_PRIVATE_KEY
# Shared provider credentials belong only to this trusted service.
NIGHTBREW_GATEWAY_API_KEY=
NIGHTBREW_GATEWAY_URL=https://api.deepseek.com/v1
NIGHTBREW_GATEWAY_MODEL=deepseek-chat
# Required: copy current model prices from the provider console. Empty values fail closed.
# Use cache-miss input pricing as a conservative input rate. USD per 1 million tokens.
NIGHTBREW_GATEWAY_INPUT_USD_PER_MILLION=
NIGHTBREW_GATEWAY_OUTPUT_USD_PER_MILLION=
# Trusted shared gateway admission; integer range 1..128. Start small and measure.
NIGHTBREW_GATEWAY_MAX_CONCURRENT=2
NIGHTBREW_GATEWAY_ACCOUNT_MAX_CONCURRENT=1
