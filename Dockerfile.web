# Personal, single-owner website preview. This is not the commercial authority.
FROM node:24-bookworm-slim AS website
WORKDIR /app
ENV ELECTRON_SKIP_BINARY_DOWNLOAD=1
COPY package.json package-lock.json ./
COPY scripts/patch-build-dependencies.cjs scripts/patch-build-dependencies.cjs
RUN npm ci
COPY tsconfig.json vite.web.config.ts web-preview.html ./
COPY src ./src
RUN node node_modules/typescript/bin/tsc --noEmit && node node_modules/vite/bin/vite.js build --config vite.web.config.ts

FROM python:3.12-slim-bookworm
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
COPY backend/requirements-web.lock.txt ./requirements-web.lock.txt
RUN pip install --no-cache-dir -r requirements-web.lock.txt && useradd --uid 10001 --create-home webapp && mkdir /data && chown 10001:10001 /data
COPY backend ./backend
COPY scripts/run-web.py ./scripts/run-web.py
COPY --from=website /app/build/web-preview ./build/web-preview
USER 10001:10001
EXPOSE 8787
CMD ["python", "scripts/run-web.py", "--data-dir", "/data", "--host", "0.0.0.0"]
